    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "@mssio/qpdf-wasm": "1.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.7",
    "alchemy": "2.0.0-beta.87",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "effect": "^4.1.5",
    "fflate": "0.8.3",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "imagetracerjs": "1.2.6",
    "lucide-react": "^1.77.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
