{
  "name": "tools",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "effect-tsgo tsc --noEmit -p tsconfig.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "repos:sync": "bash scripts/sync-repos.sh",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@effect/platform-node": "^4.1.5",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "effect": "^4.1.5",
    "lucide-react": "^1.77.0",
    "nitro": "3.0.261103-rc",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.2",
    "@effect/vitest": "^4.1.5",
    "@oxlint/plugins": "^1.94.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@tanstack/devtools-vite": "^0.8.7",
    "@tanstack/react-devtools": "^0.10.15",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.0.0"
}
