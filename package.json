{
  "name": "yohaku",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:cloudflare": "alchemy dev --stage dev",
    "build": "vite build",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy --stage prod",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "effect-tsgo tsc --noEmit -p tsconfig.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "bench": "vitest bench",
    "wasm:build": "bash scripts/wasm.sh build",
    "wasm:test": "bash scripts/wasm.sh test",
    "repos:sync": "bash scripts/sync-repos.sh",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "6.3.1",
